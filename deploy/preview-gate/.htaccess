# Bistromat — password-protected preview ("Coming soon" gate).
# Requires Apache with mod_rewrite and PHP. Remove this file and gate.php to go live.

DirectoryIndex index.html
ErrorDocument 404 /404.html

# Keep search engines out
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Files the gate page itself needs are always allowed
  RewriteRule ^(gate\.php|gate-assets/.*|favicon\.svg|favicon-32\.png|favicon-48\.png|apple-touch-icon\.png|site\.webmanifest|robots\.txt)$ - [L]

  # Everyone without the access cookie sees the gate
  RewriteCond %{HTTP_COOKIE} !bm_preview=203abd1f175fa5a73f9183848388bf2659e3a9cb2574678b
  RewriteRule ^ gate.php [L]
</IfModule>
