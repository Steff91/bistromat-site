# Bistromat — production (Apache)
# HTTPS redirect is handled by Cloudflare ("Always Use HTTPS"), not here, to avoid redirect loops.

ErrorDocument 404 /404.html
Options -Indexes

# ── COMING SOON (password gate) ─────────────────────────────────────────────
# Currently OFF. To turn it ON, remove the "#" at the start of the 7 lines below.
# Password and logout: see gate.php (PASSWORD_SHA256, ACCESS_TOKEN — the token must match the cookie line).
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#  Header set X-Robots-Tag "noindex, nofollow"
#  RewriteRule ^(gate\.php|gate-assets/.*|favicon\.svg|favicon-32\.png|favicon-48\.png|apple-touch-icon\.png|site\.webmanifest|robots\.txt)$ - [L]
#  RewriteCond %{HTTP_COOKIE} !bm_preview=203abd1f175fa5a73f9183848388bf2659e3a9cb2574678b
#  RewriteRule ^ gate.php [L]
#</IfModule>
# ────────────────────────────────────────────────────────────────────────────

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType text/calendar .ics
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files never change
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(webp|jpg|png|svg|woff2|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml application/xml
</IfModule>
