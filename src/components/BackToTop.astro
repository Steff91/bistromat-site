---
import Icon from './Icon.astro';
import { getLang, tr } from '../i18n';
const lang = getLang(Astro.url);
---

<button
  type="button"
  id="back-to-top"
  class="fixed right-5 bottom-5 z-50 inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-md border border-line bg-ink/90 text-paper backdrop-blur-md hover:border-gold hover:text-gold sm:right-6 sm:bottom-6"
  aria-label={tr(lang, 'Nazad na vrh', 'Back to top')}
  data-visible="false"
>
  <Icon name="chevron-right" size={12} class="-rotate-90" />
</button>

<style>
  #back-to-top {
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity .25s ease, transform .25s ease, visibility 0s linear .25s, color .2s ease, border-color .2s ease;
  }
  #back-to-top[data-visible='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity .25s ease, transform .25s ease, visibility 0s, color .2s ease, border-color .2s ease;
  }
  #back-to-top:hover { transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) {
    #back-to-top, #back-to-top[data-visible='true'] { transition: none; }
  }
</style>

<script>
  const btn = document.getElementById('back-to-top')!;
  const banner = document.getElementById('cookie-banner');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const small = window.matchMedia('(max-width: 639px)');

  let ticking = false;
  const update = () => {
    ticking = false;
    // On phones the cookie banner spans the full width; don't stack on top of it.
    const bannerOpen = banner ? !banner.hidden && small.matches : false;
    btn.dataset.visible = String(window.scrollY > 600 && !bannerOpen);
  };

  window.addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }, { passive: true });
  if (banner) new MutationObserver(update).observe(banner, { attributes: true, attributeFilter: ['hidden'] });
  update();

  btn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduce.matches ? 'auto' : 'smooth' });
    // Move focus to the top of the page for keyboard and screen reader users
    document.querySelector<HTMLElement>('#site-header a')?.focus({ preventScroll: true });
  });
</script>
