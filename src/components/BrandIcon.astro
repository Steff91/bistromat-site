---
// Brand icons from the Bistromat identity (fork, plate, knife, spoon, glass, bottle).
// All share one height and baseline, so they line up like the logo.
export type BrandIconName = 'fork' | 'plate' | 'knife' | 'spoon' | 'glass' | 'bottle';

interface Props {
  name: BrandIconName;
  /** Height in px; width follows the icon's proportions. */
  size?: number;
  class?: string;
}

const icons: Record<BrandIconName, { viewBox: string; d: string }> = {
  fork: { viewBox: '286.54 159.5 52.07 128', d: 'M 337.49 202.83 L 337.49 162.99 L 326.32 162.99 L 326.32 206.74 L 317.90 206.74 L 317.90 162.99 L 306.73 162.99 L 306.73 206.74 L 298.73 206.74 L 298.73 162.99 L 287.57 162.99 L 287.57 202.83 L 287.53 202.83 L 287.53 212.00 L 306.16 224.91 L 306.16 285.92 L 318.80 285.92 L 318.80 224.97 L 337.51 212.00 L 337.60 212.00 L 337.60 202.83 Z M 337.49 202.83' },
  plate: { viewBox: '369.64 159.5 132.45 128', d: 'M 456.01 161.30 L 415.70 161.30 L 383.09 184.99 L 370.64 223.32 L 383.09 261.66 L 415.70 285.36 L 456.01 285.36 L 488.62 261.66 L 501.08 223.32 L 488.62 184.99 Z M 453.12 170.18 L 481.06 190.48 L 491.73 223.32 L 481.06 256.17 L 453.12 276.47 L 418.59 276.47 L 390.65 256.17 L 379.98 223.32 L 390.65 190.48 L 418.59 170.18 Z M 453.12 170.18' },
  knife: { viewBox: '530.63 159.5 27.16 128', d: 'M 544.15 162.78 L 544.15 163.01 L 531.62 191.12 L 531.62 196.17 L 544.15 227.36 L 544.15 285.34 L 556.78 285.34 L 556.78 162.78 Z M 544.15 162.78' },
  spoon: { viewBox: '584.43 159.5 51.98 128', d: 'M 627.08 206.60 L 614.06 215.62 L 606.78 215.62 L 593.75 206.60 L 593.75 179.10 L 606.86 170.01 L 613.97 170.01 L 627.08 179.10 Z M 635.37 174.78 L 635.36 174.78 L 635.41 174.78 L 616.72 161.83 L 616.72 161.73 L 604.09 161.73 L 604.09 161.85 L 585.42 174.78 L 585.47 174.78 L 585.46 174.78 L 585.46 210.91 L 585.42 210.91 L 585.46 210.94 L 585.46 211 L 585.54 211 L 604.06 223.82 L 604.06 284.84 L 616.69 284.84 L 616.69 223.88 L 635.29 211 L 635.37 211 L 635.37 210.94 L 635.41 210.91 L 635.37 210.91 Z M 635.37 174.78' },
  glass: { viewBox: '661.76 159.5 62.43 128', d: 'M 674.72 204.32 L 711.39 204.32 L 707.38 235.12 L 679.15 235.02 Z M 716.48 245.51 L 723.19 193.96 L 662.76 193.96 L 670.17 245.35 L 687.51 245.41 L 687.51 273.80 L 679.10 273.80 L 679.10 284.82 L 687.51 284.82 L 687.51 284.84 L 698.53 284.84 L 698.53 284.82 L 706.61 284.82 L 706.61 273.80 L 698.53 273.80 L 698.53 245.45 Z M 716.48 245.51' },
  bottle: { viewBox: '750.53 159.5 50.48 128', d: 'M 789.64 274.32 L 761.89 274.32 L 761.89 208.94 L 789.64 208.94 Z M 781.98 198.58 L 781.98 163.74 L 769.34 163.74 L 769.34 198.58 L 751.53 198.58 L 751.53 284.69 L 800.01 284.69 L 800.01 198.58 Z M 781.98 198.58' },
};

const { name, size = 16, class: className } = Astro.props;
const icon = icons[name];
const [, , w, h] = icon.viewBox.split(' ').map(Number);
---

<svg
  width={Math.round((size * w) / h)}
  height={size}
  viewBox={icon.viewBox}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={className}
><path d={icon.d}></path></svg>
