---
// Google reCAPTCHA v3 (invisible, score based) for site forms. Renders nothing until info.json → recaptchaSiteKey is set.
// The secret key lives only on the server (form-config.php → RECAPTCHA_SECRET); send.php checks the token and score.
// The Google script loads only when a form comes near the viewport or gets focus.
// The floating badge is hidden; Google allows that when this notice is shown next to the form.
import { getInfo, getLang } from '../i18n';

const lang = getLang(Astro.url);
const info = getInfo(lang) as { recaptchaSiteKey?: string };
const key = info.recaptchaSiteKey ?? '';
---

{key && (
  <div class="col-span-full" data-recaptcha={key}>
    <input type="hidden" name="g-recaptcha-response" value="" />
    <p class="m-0 font-sans text-[13px] text-dim">
      {lang === 'en'
        ? <>This site is protected by reCAPTCHA and the Google <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Privacy Policy</a> and <a href="https://policies.google.com/terms" target="_blank" rel="noopener">Terms of Service</a> apply.</>
        : <>Sajt je zaštićen reCAPTCHA proverom; primenjuju se Google <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">politika privatnosti</a> i <a href="https://policies.google.com/terms" target="_blank" rel="noopener">uslovi korišćenja</a>.</>}
    </p>
  </div>
)}

<style is:global>
  .grecaptcha-badge { visibility: hidden !important; }
</style>

<script>
  type Grecaptcha = { ready(cb: () => void): void; execute(key: string, opts: { action: string }): Promise<string> };
  const holders = document.querySelectorAll<HTMLElement>('[data-recaptcha]');

  if (holders.length) {
    const key = holders[0].dataset.recaptcha!;
    let loading: Promise<Grecaptcha> | null = null;
    const load = () =>
      (loading ??= new Promise<Grecaptcha>((resolve, reject) => {
        const s = document.createElement('script');
        s.src = `https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(key)}`;
        s.async = true;
        s.onload = () => {
          const g = (window as unknown as { grecaptcha: Grecaptcha }).grecaptcha;
          g.ready(() => resolve(g));
        };
        s.onerror = reject;
        document.head.append(s);
      }));

    holders.forEach((h) => {
      const form = h.closest('form');
      if (!form) return;
      const field = h.querySelector<HTMLInputElement>('input[name="g-recaptcha-response"]')!;
      // Coming back via the browser's Back button: start over with a new token
      window.addEventListener('pageshow', () => { field.value = ''; delete form.dataset.captchaTried; });
      form.addEventListener('focusin', () => { load().catch(() => {}); }, { once: true });

      // Get a fresh token right before sending (tokens expire after 2 minutes)
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        e.stopImmediatePropagation();
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (btn) btn.disabled = true;
        const timeout = new Promise<never>((_, reject) => setTimeout(() => reject(new Error('timeout')), 8000));
        Promise.race([load().then((g) => g.execute(key, { action: 'submit' })), timeout])
          .then((token) => { field.value = token; })
          .catch(() => {}) // send anyway; the server decides
          .finally(() => {
            if (btn) btn.disabled = false;
            form.dataset.captchaTried = '1';
            // The browser already validated the fields on the first submit; send without re-firing events
            HTMLFormElement.prototype.submit.call(form);
          });
      });
    });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load().catch(() => {}); }
      }, { rootMargin: '400px 0px' });
      holders.forEach((h) => io.observe(h));
    }
  }
</script>
