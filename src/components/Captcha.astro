---
// Google reCAPTCHA v2 ("I'm not a robot" checkbox) for site forms. Renders nothing until info.json → recaptchaSiteKey is set.
// The secret key lives only on the server (form-config.php → RECAPTCHA_SECRET), checked in send.php.
// The Google script loads only when a form comes near the viewport or gets focus.
import { getInfo, getLang, tr } from '../i18n';

const lang = getLang(Astro.url);
const info = getInfo(lang) as { recaptchaSiteKey?: string };
const key = info.recaptchaSiteKey ?? '';
---

{key && (
  <div class="col-span-full">
    <div class="g-recaptcha" data-sitekey={key} data-theme="dark"></div>
    <p class="captcha-wait m-0 mt-2 hidden font-sans text-[14px] text-gold" role="alert">
      {tr(lang, 'Potvrdite da niste robot, pa pošaljite ponovo.', 'Please confirm you are not a robot, then send again.')}
    </p>
  </div>
)}

<script>
  const widgets = document.querySelectorAll<HTMLElement>('.g-recaptcha');
  if (widgets.length) {
    let loaded = false;
    const load = () => {
      if (loaded) return;
      loaded = true;
      const s = document.createElement('script');
      s.src = 'https://www.google.com/recaptcha/api.js' + (document.documentElement.lang === 'en' ? '?hl=en' : '');
      s.async = true;
      s.defer = true;
      document.head.append(s);
    };

    widgets.forEach((w) => {
      const form = w.closest('form');
      if (!form) return;
      form.addEventListener('focusin', load, { once: true });
      // Don't send before the checkbox is ticked
      form.addEventListener('submit', (e) => {
        const token = form.querySelector<HTMLTextAreaElement>('textarea[name="g-recaptcha-response"]');
        if (!token?.value) {
          e.preventDefault();
          e.stopImmediatePropagation();
          load();
          form.querySelector('.captcha-wait')?.classList.remove('hidden');
        }
      });
    });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
      }, { rootMargin: '400px 0px' });
      widgets.forEach((w) => io.observe(w));
    } else {
      load();
    }
  }
</script>
