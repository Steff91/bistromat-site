---
// Cookie consent. Categories: necessary (always on) and external content (maps, reservation widget).
// Add an "analytics" category here before adding any analytics script.
import { getLang, route, tr } from '../i18n';
const lang = getLang(Astro.url);
---

<div
  id="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-text"
  class="fixed inset-x-4 bottom-4 z-[60] max-w-[460px] rounded-md border border-line bg-ink p-6 shadow-[0_24px_60px_-20px_rgba(0,0,0,0.9)] sm:left-6 sm:right-auto sm:bottom-6"
  hidden
>
  <p id="cookie-title" class="m-0 text-[16px] font-semibold uppercase tracking-[0.04em]">{tr(lang, 'Kolačići', 'Cookies')}</p>
  <p id="cookie-text" class="mt-2 mb-0 font-sans text-[15px] leading-relaxed text-muted">
    {tr(lang, 'Sajt ne koristi kolačiće za praćenje. Mapu prikazuje Google, koji može postaviti svoje kolačiće.', 'This site uses no tracking cookies. The map is provided by Google, which may set its own cookies.')}{' '}
    <a href={route('cookies', lang)}>{tr(lang, 'Saznajte više', 'Learn more')}</a>.
  </p>

  <form class="mt-4 flex flex-col gap-3 border-t border-line pt-4" data-cookie-prefs hidden>
    <label class="flex items-start gap-3 font-sans text-[15px] text-muted">
      <input type="checkbox" checked disabled class="mt-1 h-4 w-4 accent-[#D4AF6A]" />
      <span><span class="font-mono text-[14px] font-medium uppercase tracking-[0.04em] text-paper">{tr(lang, 'Neophodni', 'Necessary')}</span><br />{tr(lang, 'Pamćenje vašeg izbora. Uvek uključeno.', 'Remembers your choice. Always on.')}</span>
    </label>
    <label class="flex items-start gap-3 font-sans text-[15px] text-muted">
      <input type="checkbox" name="external" class="mt-1 h-4 w-4 accent-[#D4AF6A]" />
      <span><span class="font-mono text-[14px] font-medium uppercase tracking-[0.04em] text-paper">{tr(lang, 'Spoljni sadržaj', 'External content')}</span><br />{tr(lang, 'Google mape.', 'Google Maps.')}</span>
    </label>
  </form>

  <div class="mt-5 flex flex-wrap gap-2.5">
    <button type="button" class="btn btn-primary cursor-pointer border-0 !px-5 !py-3" data-cookie-accept>{tr(lang, 'Prihvati sve', 'Accept all')}</button>
    <button type="button" class="btn btn-outline cursor-pointer bg-transparent !px-5 !py-3" data-cookie-necessary>{tr(lang, 'Samo neophodni', 'Necessary only')}</button>
    <button type="button" class="cursor-pointer border-0 bg-transparent px-1 font-mono text-[14px] text-gold underline-offset-4 hover:underline" data-cookie-settings>{tr(lang, 'Podešavanja', 'Settings')}</button>
    <button type="button" class="btn btn-outline cursor-pointer bg-transparent !px-5 !py-3" data-cookie-save hidden>{tr(lang, 'Sačuvaj izbor', 'Save choice')}</button>
  </div>
</div>

<script>
  const KEY = 'bm-consent';
  const VERSION = 1;
  type Consent = { v: number; external: boolean; at: string };

  const banner = document.getElementById('cookie-banner')!;
  const prefs = banner.querySelector<HTMLFormElement>('[data-cookie-prefs]')!;
  const externalBox = prefs.querySelector<HTMLInputElement>('input[name="external"]')!;
  const saveBtn = banner.querySelector<HTMLButtonElement>('[data-cookie-save]')!;
  const settingsBtn = banner.querySelector<HTMLButtonElement>('[data-cookie-settings]')!;

  const read = (): Consent | null => {
    try {
      const c = JSON.parse(localStorage.getItem(KEY) ?? 'null');
      return c && c.v === VERSION ? c : null;
    } catch {
      return null;
    }
  };

  const write = (external: boolean) => {
    const c: Consent = { v: VERSION, external, at: new Date().toISOString() };
    try { localStorage.setItem(KEY, JSON.stringify(c)); } catch { /* private mode */ }
    apply(c);
    close();
  };

  // Insert embed HTML; scripts are recreated so provider snippets actually run.
  const load = (wrap: HTMLElement) => {
    const tpl = wrap.querySelector<HTMLTemplateElement>('template[data-consent-content]');
    if (!tpl) return;
    const frag = tpl.content.cloneNode(true) as DocumentFragment;
    frag.querySelectorAll('script').forEach((old) => {
      const s = document.createElement('script');
      [...old.attributes].forEach((a) => s.setAttribute(a.name, a.value));
      s.textContent = old.textContent;
      old.replaceWith(s);
    });
    wrap.querySelector('[data-consent-placeholder]')?.remove();
    tpl.replaceWith(frag);
  };

  const apply = (c: Consent | null) => {
    if (c?.external) document.querySelectorAll<HTMLElement>('[data-consent-embed]').forEach(load);
  };

  const open = (withSettings = false) => {
    externalBox.checked = read()?.external ?? false;
    prefs.hidden = !withSettings;
    saveBtn.hidden = !withSettings;
    settingsBtn.hidden = withSettings;
    banner.hidden = false;
  };
  const close = () => { banner.hidden = true; };

  banner.querySelector('[data-cookie-accept]')!.addEventListener('click', () => write(true));
  banner.querySelector('[data-cookie-necessary]')!.addEventListener('click', () => write(false));
  settingsBtn.addEventListener('click', () => open(true));
  saveBtn.addEventListener('click', () => write(externalBox.checked));

  // Per-embed buttons
  document.querySelectorAll<HTMLElement>('[data-consent-embed]').forEach((wrap) => {
    wrap.querySelector('[data-consent-load]')?.addEventListener('click', () => load(wrap));
    wrap.querySelector('[data-consent-allow]')?.addEventListener('click', () => write(true));
  });

  // Footer link "Podešavanja kolačića"
  document.querySelectorAll('[data-open-cookie-settings]').forEach((el) =>
    el.addEventListener('click', (e) => { e.preventDefault(); open(true); }),
  );

  const current = read();
  if (current) apply(current);
  else open();
</script>
