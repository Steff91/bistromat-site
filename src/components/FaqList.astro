---
// Accordion FAQ built on <details>: works without JS, animates open/close with JS.
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq-list border-t border-line">
  {items.map((f, i) => (
    <details class="faq border-b border-line" data-reveal style={`--i:${i % 4}`}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-medium">
        <span class="faq-q">{f.q}</span>
        <span class="faq-icon inline-flex shrink-0 text-gold"><Icon name="chevron-right" size={11} /></span>
      </summary>
      <div class="faq-body">
        <p class="mt-0 mb-6 max-w-[620px] font-sans text-muted">{f.a}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq summary::-webkit-details-marker { display: none; }

  /* Question: color + opacity ease on hover */
  .faq-q { opacity: .88; transition: color .3s ease, opacity .3s ease; }
  .faq summary:hover .faq-q,
  .faq summary:focus-visible .faq-q,
  .faq[open] .faq-q { opacity: 1; color: var(--color-gold); }

  /* Chevron turns from down to up */
  .faq-icon { rotate: 90deg; transition: rotate .35s ease; }
  .faq[open] .faq-icon { rotate: -90deg; }

  .faq-body { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .faq-q, .faq-icon { transition: none; }
  }
</style>

<script>
  // Smooth height + fade for <details>. Falls back to native toggle if animations are off.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const DURATION = 380;
  const EASE = 'cubic-bezier(.2, .7, .2, 1)';

  document.querySelectorAll<HTMLDetailsElement>('.faq').forEach((details) => {
    const summary = details.querySelector('summary')!;
    const body = details.querySelector<HTMLElement>('.faq-body')!;
    let anim: Animation | null = null;

    summary.addEventListener('click', (e) => {
      if (reduce.matches || !body.animate) return; // native behavior
      e.preventDefault();
      anim?.cancel();

      if (!details.open) {
        details.open = true;
        const h = body.scrollHeight;
        anim = body.animate(
          [{ height: '0px', opacity: 0 }, { height: `${h}px`, opacity: 1 }],
          { duration: DURATION, easing: EASE },
        );
      } else {
        const h = body.offsetHeight;
        anim = body.animate(
          [{ height: `${h}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
          { duration: DURATION * 0.8, easing: EASE },
        );
        anim.onfinish = () => { details.open = false; };
      }
      anim.oncancel = () => { anim = null; };
    });
  });
</script>
