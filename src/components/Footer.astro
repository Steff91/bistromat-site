---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Social from './Social.astro';
import info from '../data/info.json';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-ink-deep">
  <div class="container-site grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-10 pt-[72px] pb-12">
    <div class="flex flex-col gap-4">
      <Logo size={36} />
      <p class="m-0 font-sans text-sm text-dim">Francuska kuhinja u otvorenoj kuhinji. Vračar, Beograd.</p>
      <Social />
    </div>

    <nav aria-label="Navigacija u podnožju" class="flex flex-col gap-2.5 text-sm">
      <p class="m-0 mb-1.5 text-xs uppercase tracking-[0.16em] text-gold">Navigacija</p>
      <a href="/meni/" class="text-[#D9D4CC] no-underline hover:text-paper">Meni</a>
      <a href="/chefs-table/" class="text-[#D9D4CC] no-underline hover:text-paper">Chef's Table</a>
      <a href="/#dogadjaji" class="text-[#D9D4CC] no-underline hover:text-paper">Događaji</a>
      <a href="/#rezervacija" class="text-[#D9D4CC] no-underline hover:text-paper">Rezervacije</a>
      <a href="/#kontakt" class="text-[#D9D4CC] no-underline hover:text-paper">Kontakt</a>
    </nav>

    <nav aria-label="Usluge" class="flex flex-col gap-2.5 text-sm">
      <p class="m-0 mb-1.5 text-xs uppercase tracking-[0.16em] text-gold">Usluge</p>
      {services.map((s) => (
        <a href={`/usluge/${s.id}/`} class="text-[#D9D4CC] no-underline hover:text-paper">{s.data.title}</a>
      ))}
    </nav>

    <div class="flex flex-col gap-2.5 text-sm">
      <p class="m-0 mb-1.5 text-xs uppercase tracking-[0.16em] text-gold">Kontakt</p>
      <span class="text-[#D9D4CC]">{info.address}, {info.city}</span>
      <a href={`tel:${info.phoneHref}`} class="text-[#D9D4CC] no-underline hover:text-paper">{info.phone}</a>
      <span class="font-sans text-dim">
        {info.hours.map((h) => (<>{h.day}: {h.time}<br /></>))}
      </span>
    </div>
  </div>

  <div class="border-t border-[#1F1F1F]">
    <div class="container-site flex flex-wrap justify-between gap-3 py-5 text-xs text-dim">
      <span>© {year} Bistromat. Sva prava zadržana.</span>
      <span>
        <a href="/privatnost/" class="text-dim hover:text-paper">Politika privatnosti</a>{' · '}
        <a href="/kolacici/" class="text-dim hover:text-paper">Kolačići</a>
      </span>
    </div>
  </div>
</footer>
