---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { FEATURES } from '../config';
import { getLang, route, servicesBase, tr, type Lang } from '../i18n';
import { getServices, serviceHref } from '../i18n/content';

interface Props {
  alternates: Record<Lang, string>;
}
const { alternates } = Astro.props;

const lang = getLang(Astro.url);
const path = Astro.url.pathname;
const services = await getServices(lang);
const servicesActive = path.startsWith(servicesBase(lang));
const inquiryHref = `${await serviceHref('privatne-proslave', lang)}#upit`;

const linksBefore = [{ href: route('menu', lang), label: tr(lang, 'Meni', 'Menu') }];
const linksAfter = [
  FEATURES.chefsTable && { href: route('chefsTable', lang), label: "Chef's Table" },
  FEATURES.events && { href: route('events', lang), label: tr(lang, 'Događaji', 'Events') },
  { href: route('contact', lang), label: tr(lang, 'Kontakt', 'Contact') },
].filter(Boolean) as { href: string; label: string }[];
const t = {
  nav: tr(lang, 'Glavna navigacija', 'Main navigation'),
  services: tr(lang, 'Usluge', 'Services'),
  book: tr(lang, 'Rezerviši', 'Book a table'),
  open: tr(lang, 'Otvori meni', 'Open menu'),
  close: tr(lang, 'Zatvori meni', 'Close menu'),
  idea: tr(lang, 'Imate drugu ideju?', 'Have another idea?'),
  inquiry: tr(lang, 'Pošalji upit', 'Send an inquiry'),
  mobileNav: tr(lang, 'Mobilna navigacija', 'Mobile navigation'),
};

const navLink = 'nav-link font-medium no-underline text-paper hover:text-paper';
const mobileLink = 'border-b border-line py-3.5 font-medium no-underline text-paper hover:text-gold';
---

<header id="site-header" class="sticky top-0 z-50 border-b border-line bg-ink/90 backdrop-blur-md">
  <div class="header-inner container-site flex items-center justify-between gap-4 py-[18px]">
    <Logo />

    <nav aria-label={t.nav} class="hidden items-center gap-6 text-[14px] uppercase tracking-[0.06em] lg:flex">
      {linksBefore.map((l) => {
        const active = path.startsWith(l.href);
        return <a href={l.href} class:list={[navLink, active && '!text-gold']} aria-current={active ? 'page' : undefined}>{l.label}</a>;
      })}

      {services.length > 0 && (
      <button
        type="button"
        id="mega-trigger"
        class:list={[
          'nav-link inline-flex cursor-pointer items-center gap-1.5 border-0 bg-transparent p-0 font-mono text-[14px] font-medium uppercase tracking-[0.06em]',
          servicesActive ? 'text-gold' : 'text-paper',
        ]}
        aria-expanded="false"
        aria-controls="mega-menu"
      >
        {t.services}
        <span class="mega-chevron inline-flex"><Icon name="chevron-right" size={9} /></span>
      </button>
      )}

      {linksAfter.map((l) => {
        const active = l.href.startsWith('/') && !l.href.includes('#') && path.startsWith(l.href);
        return <a href={l.href} class:list={[navLink, active && '!text-gold']} aria-current={active ? 'page' : undefined}>{l.label}</a>;
      })}
      <a href={route('reservations', lang)} class="btn btn-primary !px-5 !py-[11px]">{t.book}</a>
    </nav>

    <div class="flex items-center gap-3 lg:hidden">
    <LangSwitch alternates={alternates} class="text-[13px]" />
    <button
      type="button"
      class="menu-toggle inline-flex h-11 w-11 cursor-pointer items-center justify-center border-0 bg-transparent text-paper lg:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label={t.open}
      data-label-open={t.open}
      data-label-close={t.close}
    >
      <span class="menu-icon" aria-hidden="true"><span></span></span>
    </button>
    </div>
  </div>

  <!-- Desktop mega menu -->
  {services.length > 0 && (
  <div id="mega-menu" class="mega absolute inset-x-0 top-full hidden border-b border-line bg-ink lg:block" data-open="false">
    <div class="container-site py-10">
      <div class="grid grid-cols-4 gap-px border border-line bg-line">
        {services.map((s) => (
          <a
            href={s.href}
            class:list={[
              'card group flex flex-col gap-2 bg-ink p-6 no-underline',
              path.startsWith(s.href) ? 'text-gold' : 'text-paper hover:text-paper',
            ]}
          >
            <span class="text-[13px] text-gold">[0{s.data.order}]</span>
            <span class="text-[15px] font-semibold uppercase tracking-[0.03em]">{s.data.title}</span>
            <span class="font-sans text-[14px] leading-snug text-muted">{s.data.excerpt}</span>
          </a>
        ))}
        <a href={inquiryHref} class="card group flex flex-col gap-2 bg-gold p-6 text-ink no-underline hover:text-ink">
          <span class="text-[13px]">[+]</span>
          <span class="text-[15px] font-semibold uppercase tracking-[0.03em]">{t.idea}</span>
          <span class="mt-auto inline-flex items-center gap-2 text-[14px] font-semibold">
            {t.inquiry} <Icon name="chevron-right" size={10} />
          </span>
        </a>
      </div>
    </div>
  </div>
  )}

  <!-- Mobile menu -->
  <nav id="mobile-nav" aria-label={t.mobileNav} class="mobile-nav max-h-[calc(100dvh-80px)] overflow-y-auto border-t border-line lg:hidden" hidden>
    <div class="container-site flex flex-col py-4 text-[15px] uppercase tracking-[0.06em]">
      {linksBefore.map((l) => {
        const active = path.startsWith(l.href);
        return <a href={l.href} class:list={[mobileLink, active && '!text-gold']} aria-current={active ? 'page' : undefined}>{l.label}</a>;
      })}

      {services.length > 0 && (<>
      <button
        type="button"
        id="mobile-services-toggle"
        class:list={[
          'flex w-full cursor-pointer items-center justify-between border-0 border-b border-solid border-line bg-transparent px-0 py-3.5 text-left font-mono text-[15px] font-medium uppercase tracking-[0.06em]',
          servicesActive ? 'text-gold' : 'text-paper',
        ]}
        aria-expanded="false"
        aria-controls="mobile-services"
      >
        {t.services}
        <span class="mega-chevron inline-flex"><Icon name="chevron-right" size={10} /></span>
      </button>
      <div id="mobile-services" class="flex flex-col border-b border-line py-2 pl-4" hidden>
        {services.map((s) => (
          <a
            href={s.href}
            class:list={['py-2.5 text-[14px] no-underline', path.startsWith(s.href) ? 'text-gold' : 'text-muted hover:text-gold']}
          >{s.data.title}</a>
        ))}
      </div>
      </>)}

      {linksAfter.map((l) => {
        const active = l.href.startsWith('/') && !l.href.includes('#') && path.startsWith(l.href);
        return <a href={l.href} class:list={[mobileLink, active && '!text-gold']} aria-current={active ? 'page' : undefined}>{l.label}</a>;
      })}
      <a href={route('reservations', lang)} class="btn btn-primary mt-5 justify-center">{t.book}</a>
    </div>
  </nav>
</header>

<style>
  .header-inner { transition: padding .25s ease; }
  #site-header.is-scrolled .header-inner { padding-block: 10px; }

  .nav-link {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size .3s ease;
    padding-bottom: 2px;
  }
  .nav-link:hover, #mega-trigger[aria-expanded='true'] { background-size: 100% 1px; }

  .mega-chevron { transform: rotate(90deg); transition: transform .25s ease; }
  [aria-expanded="true"] .mega-chevron { transform: rotate(-90deg); }

  /* Mega menu open/close */
  .mega {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .2s ease, transform .2s ease, visibility 0s linear .2s;
  }
  .mega[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity .2s ease, transform .2s ease, visibility 0s;
  }

  /* Hamburger → X */
  .menu-icon, .menu-icon span, .menu-icon::before, .menu-icon::after {
    display: block; width: 22px; height: 1.5px; background: currentColor;
    transition: transform .25s ease, opacity .2s ease;
  }
  .menu-icon { position: relative; background: transparent; }
  .menu-icon::before, .menu-icon::after { content: ''; position: absolute; left: 0; }
  .menu-icon::before { top: -7px; }
  .menu-icon::after { top: 7px; }
  .menu-toggle[aria-expanded='true'] .menu-icon span { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-icon::before { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-icon::after { transform: translateY(-7px) rotate(-45deg); }

  .mobile-nav:not([hidden]) { animation: drop .25s ease; }
  @keyframes drop { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .header-inner, .nav-link, .mega, .mega-chevron, .menu-icon, .menu-icon span, .menu-icon::before, .menu-icon::after { transition: none; }
    .mobile-nav:not([hidden]) { animation: none; }
  }
</style>

<script>
  const header = document.getElementById('site-header');

  // --- Compact header after scrolling ---
  // Shrinking the header changes page height, so a single threshold makes the class
  // flip back and forth near the top (page "vibrates"). Use separate on/off thresholds
  // wider than the height change, and update at most once per frame.
  const COMPACT_AT = 80;
  const EXPAND_AT = 8;
  let ticking = false;
  const update = () => {
    ticking = false;
    if (!header) return;
    const y = window.scrollY;
    const compact = header.classList.contains('is-scrolled');
    if (!compact && y > COMPACT_AT) header.classList.add('is-scrolled');
    else if (compact && y < EXPAND_AT) header.classList.remove('is-scrolled');
  };
  update();
  window.addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }, { passive: true });

  // --- Desktop mega menu ---
  const trigger = document.getElementById('mega-trigger');
  const mega = document.getElementById('mega-menu');
  let closeTimer: number | undefined;

  const setMega = (open: boolean) => {
    if (!trigger || !mega) return;
    window.clearTimeout(closeTimer);
    trigger.setAttribute('aria-expanded', String(open));
    mega.dataset.open = String(open);
  };
  const scheduleClose = () => {
    window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(() => setMega(false), 180);
  };

  trigger?.addEventListener('click', () => setMega(trigger.getAttribute('aria-expanded') !== 'true'));
  if (window.matchMedia('(hover: hover)').matches) {
    [trigger, mega].forEach((el) => {
      el?.addEventListener('mouseenter', () => setMega(true));
      el?.addEventListener('mouseleave', scheduleClose);
    });
  }
  mega?.addEventListener('focusout', (e) => {
    const next = (e as FocusEvent).relatedTarget as Node | null;
    if (!next || (!mega.contains(next) && next !== trigger)) setMega(false);
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (mega?.dataset.open === 'true' && !mega.contains(t) && !trigger?.contains(t)) setMega(false);
  });

  // --- Mobile menu ---
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const setMobile = (open: boolean) => {
    if (!toggle || !mobileNav) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
    mobileNav.hidden = !open;
  };
  toggle?.addEventListener('click', () => setMobile(toggle.getAttribute('aria-expanded') !== 'true'));
  mobileNav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMobile(false)));

  const servicesToggle = document.getElementById('mobile-services-toggle');
  const servicesList = document.getElementById('mobile-services');
  servicesToggle?.addEventListener('click', () => {
    if (!servicesList) return;
    const open = servicesToggle.getAttribute('aria-expanded') !== 'true';
    servicesToggle.setAttribute('aria-expanded', String(open));
    servicesList.hidden = !open;
  });

  // --- Shared ---
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (mega?.dataset.open === 'true') { setMega(false); trigger?.focus(); }
    setMobile(false);
  });
  window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
    if (e.matches) setMobile(false);
    else setMega(false);
  });
</script>
