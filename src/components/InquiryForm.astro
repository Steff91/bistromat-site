---
import { getInfo, getLang, route, tr } from '../i18n';
import { FEATURES } from '../config';

type Variant = 'event' | 'catering' | 'workshop' | 'voucher' | 'seats' | 'contact';

interface Props {
  service: string;
  variant?: Variant;
  /** Package / workshop / voucher names offered in a select */
  options?: string[];
  /** For the 'seats' variant: bookable dates ({ value, label }) */
  dates?: { value: string; label: string }[];
}
const { service, variant = 'event', options = [], dates = [] } = Astro.props;

const lang = getLang(Astro.url);
const info = getInfo(lang);
const en = lang === 'en';

const copy: Record<Variant, { title: string; lead: string; submit: string }> = en
  ? {
      event: { title: 'Check availability', lead: 'Or call us directly:', submit: 'Send inquiry' },
      catering: { title: 'Request a quote', lead: 'Or call us directly:', submit: 'Send inquiry' },
      workshop: { title: 'Sign up', lead: 'For private sessions or questions, call:', submit: 'Sign up' },
      voucher: { title: 'Order a voucher', lead: 'Or call us directly:', submit: 'Order voucher' },
      seats: { title: 'Book a seat', lead: 'Or call us directly:', submit: 'Book a seat' },
      contact: { title: 'Write to us', lead: 'For table bookings, calling is quickest:', submit: 'Send message' },
    }
  : {
      event: { title: 'Proverite slobodan termin', lead: 'Ili pozovite direktno:', submit: 'Pošalji upit' },
      catering: { title: 'Zatražite ponudu', lead: 'Ili pozovite direktno:', submit: 'Pošalji upit' },
      workshop: { title: 'Prijavite se', lead: 'Za privatne termine ili pitanja pozovite:', submit: 'Pošalji prijavu' },
      voucher: { title: 'Naručite vaučer', lead: 'Ili pozovite direktno:', submit: 'Naruči vaučer' },
      seats: { title: 'Rezervišite mesto', lead: 'Ili pozovite direktno:', submit: 'Rezerviši mesto' },
      contact: { title: 'Pišite nam', lead: 'Za rezervacije stola najbrže je telefonom:', submit: 'Pošalji poruku' },
    };
const c = copy[variant];
const thanks = new URL(`${route('thanks', lang)}?tip=${variant === 'contact' ? 'poruka' : 'upit'}`, Astro.site).toString();

// Field labels and select options
const L = {
  date: tr(lang, 'Datum', 'Date'),
  duration: tr(lang, 'Trajanje', 'Duration'),
  durations: en ? ['4 hours', '6 hours', 'Full day'] : ['4 sata', '6 sati', 'Ceo dan'],
  guests: tr(lang, 'Broj gostiju', 'Number of guests'),
  eg: tr(lang, 'npr.', 'e.g.'),
  kind: tr(lang, 'Vrsta događaja', 'Type of event'),
  eventKinds: en
    ? ['Birthday', 'Anniversary', 'Engagement', 'Wedding', 'Christening / family celebration', 'Business event', 'Other']
    : ['Rođendan', 'Godišnjica', 'Veridba', 'Svadba', 'Krštenje / slava', 'Poslovni događaj', 'Drugo'],
  cateringKinds: en
    ? ['Home party', 'Business event', 'Cocktail reception', 'Other']
    : ['Kućna proslava', 'Poslovni događaj', 'Koktel prijem', 'Drugo'],
  package: tr(lang, 'Paket', 'Package'),
  address: tr(lang, 'Adresa događaja', 'Event address'),
  workshop: tr(lang, 'Radionica', 'Workshop'),
  participants: tr(lang, 'Broj učesnika', 'Number of participants'),
  private: tr(lang, 'Želim privatni termin za svoju grupu', 'I would like a private session for my group'),
  slot: tr(lang, 'Termin', 'Date'),
  people: tr(lang, 'Broj osoba', 'Number of people'),
  topic: tr(lang, 'Tema', 'Topic'),
  topics: FEATURES.services
    ? en
      ? ['Table booking', 'Private event', 'Catering', 'Gift voucher', 'Collaboration', 'Working at Bistromat', 'Other']
      : ['Rezervacija stola', 'Privatni događaj', 'Ketering', 'Poklon vaučer', 'Saradnja', 'Posao u Bistromatu', 'Ostalo']
    : en
      ? ['Table booking', ...(FEATURES.chefsTable ? ["Chef's Table"] : []), ...(FEATURES.events ? ['Events'] : []), 'Collaboration', 'Working at Bistromat', 'Other']
      : ['Rezervacija stola', ...(FEATURES.chefsTable ? ["Chef's Table"] : []), ...(FEATURES.events ? ['Događaji'] : []), 'Saradnja', 'Posao u Bistromatu', 'Ostalo'],
  voucherKind: tr(lang, 'Vrsta vaučera', 'Voucher type'),
  voucherCount: tr(lang, 'Broj vaučera', 'Number of vouchers'),
  recipient: tr(lang, 'Ime primaoca', "Recipient's name"),
  dedication: tr(lang, 'Posveta na vaučeru (opciono)', 'Dedication on the voucher (optional)'),
  name: tr(lang, 'Ime i prezime', 'Full name'),
  phone: tr(lang, 'Telefon', 'Phone'),
  message: variant === 'contact' ? tr(lang, 'Poruka', 'Message') : tr(lang, 'Poruka (alergije, posebne želje)', 'Message (allergies, special requests)'),
  inquiry: tr(lang, 'Upit', 'Inquiry'),
};

// Forms post to public/send.php (info.json → formAction); recipient is set in form-config.php on the server.
const field = 'flex flex-col gap-2 text-[14px] uppercase tracking-[0.06em] text-muted';
const input = 'rounded-md border border-[#3A3A3A] bg-[#161616] p-3.5 font-sans text-[16px] normal-case tracking-normal text-paper focus:border-gold focus:outline-none';
---

<section id="upit" class="container-site flex flex-wrap gap-14 py-24">
  <div class="min-w-0 flex-[1_1_320px]">
    <p class="eyebrow" data-reveal>{variant === 'contact' ? service : `${L.inquiry} · ${service}`}</p>
    <h2 class="h-section m-0" data-reveal style="--i:1">{c.title}</h2>
    <p class="mt-5 font-sans text-muted" data-reveal style="--i:2">{c.lead}</p>
    <a href={`tel:${info.phoneHref}`} class="mt-2 inline-block text-[28px] font-medium text-paper no-underline hover:text-gold" data-reveal style="--i:3">{info.phone}</a>
  </div>

  <form
    method="POST"
    action={info.formAction || undefined}
    class="grid min-w-0 flex-[2_1_520px] grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-5"
    data-reveal
    style="--i:1"
    data-form
  >
    <input type="hidden" name="usluga" value={service} />
    <input type="hidden" name="redirect" value={thanks} />
    <input type="hidden" name="jezik" value={lang} />
    <div class="hidden" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

    {variant === 'event' && (
      <>
        <label class={field}>{L.date}
          <input type="date" name="datum" required class={input} />
        </label>
        <label class={field}>{L.duration}
          <select name="trajanje" class={input}>
            {L.durations.map((o) => <option>{o}</option>)}
          </select>
        </label>
        <label class={field}>{L.guests}
          <input type="number" name="gosti" min="1" placeholder={`${L.eg} 30`} required class={input} />
        </label>
        <label class={field}>{L.kind}
          <select name="vrsta" class={input}>
            {L.eventKinds.map((o) => <option>{o}</option>)}
          </select>
        </label>
        {options.length > 0 && (
          <label class={field}>{L.package}
            <select name="paket" class={input}>{options.map((o) => <option>{o}</option>)}</select>
          </label>
        )}
      </>
    )}

    {variant === 'catering' && (
      <>
        <label class={field}>{L.date}
          <input type="date" name="datum" required class={input} />
        </label>
        <label class={field}>{L.guests}
          <input type="number" name="gosti" min="1" placeholder={`${L.eg} 50`} required class={input} />
        </label>
        <label class={field}>{L.kind}
          <select name="vrsta" class={input}>
            {L.cateringKinds.map((o) => <option>{o}</option>)}
          </select>
        </label>
        <label class={field}>{L.address}
          <input type="text" name="adresa" autocomplete="street-address" required class={input} />
        </label>
      </>
    )}

    {variant === 'workshop' && (
      <>
        {options.length > 0 && (
          <label class={field}>{L.workshop}
            <select name="radionica" class={input}>{options.map((o) => <option>{o}</option>)}</select>
          </label>
        )}
        <label class={field}>{L.participants}
          <input type="number" name="ucesnici" min="1" placeholder={`${L.eg} 2`} required class={input} />
        </label>
        <label class="col-span-full flex items-center gap-3 font-sans text-[16px] text-muted">
          <input type="checkbox" name="privatni_termin" class="h-4 w-4 accent-[#D4AF6A]" />
          {L.private}
        </label>
      </>
    )}

    {variant === 'seats' && (
      <>
        <label class={field}>{L.slot}
          <select name="termin" id="seats-date" required class={input}>
            {dates.map((d) => <option value={d.value}>{d.label}</option>)}
          </select>
        </label>
        <label class={field}>{L.people}
          <input type="number" name="osobe" min="1" max="12" value="2" required class={input} />
        </label>
      </>
    )}

    {variant === 'contact' && (
      <label class:list={[field, 'col-span-full']}>{L.topic}
        <select name="tema" class={input}>
          {L.topics.map((o) => <option>{o}</option>)}
        </select>
      </label>
    )}

    {variant === 'voucher' && (
      <>
        {options.length > 0 && (
          <label class={field}>{L.voucherKind}
            <select name="vaucer" class={input}>{options.map((o) => <option>{o}</option>)}</select>
          </label>
        )}
        <label class={field}>{L.voucherCount}
          <input type="number" name="kolicina" min="1" value="1" required class={input} />
        </label>
        <label class={field}>{L.recipient}
          <input type="text" name="primalac" class={input} />
        </label>
        <label class:list={[field, 'col-span-full']}>{L.dedication}
          <input type="text" name="posveta" maxlength="120" class={input} />
        </label>
      </>
    )}

    <label class={field}>{L.name}
      <input type="text" name="ime" autocomplete="name" required class={input} />
    </label>
    <label class={field}>Email
      <input type="email" name="email" autocomplete="email" required class={input} />
    </label>
    <label class={field}>{L.phone}
      <input type="tel" name="telefon" autocomplete="tel" class={input} />
    </label>
    {variant !== 'voucher' && (
      <label class:list={[field, 'col-span-full']}>{L.message}
        <textarea name="poruka" rows="4" class:list={[input, 'resize-y']}></textarea>
      </label>
    )}
    <div class="col-span-full">
      <button type="submit" class="btn btn-primary cursor-pointer border-0">{c.submit}</button>
      <p class="m-0 mt-3 font-sans text-[14px] text-dim">
        {en ? <>By sending this form you agree to the processing of your data as described in our <a href={route('privacy', lang)}>Privacy policy</a>.</> : <>Slanjem forme prihvatate obradu podataka u skladu sa <a href={route('privacy', lang)}>Politikom privatnosti</a>.</>}
      </p>
    </div>
  </form>
</section>
