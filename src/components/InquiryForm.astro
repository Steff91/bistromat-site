---
import info from '../data/info.json';

interface Props {
  service: string;
  packages?: string[];
}
const { service, packages = [] } = Astro.props;

// Static site: the form posts to an external handler (e.g. Formspree) set in info.json → formAction.
const field = 'flex flex-col gap-2 text-[13px] uppercase tracking-[0.06em] text-muted';
const input = 'rounded-md border border-[#3A3A3A] bg-[#161616] p-3.5 font-sans text-[15px] normal-case tracking-normal text-paper focus:border-gold focus:outline-none';
---

<section id="upit" class="container-site flex flex-wrap gap-14 py-24">
  <div class="min-w-0 flex-[1_1_320px]">
    <p class="eyebrow" data-reveal>Upit · {service}</p>
    <h2 class="h-section m-0" data-reveal style="--i:1">Proverite slobodan termin</h2>
    <p class="mt-5 font-sans text-muted" data-reveal style="--i:2">Ili pozovite direktno:</p>
    <a href={`tel:${info.phoneHref}`} class="mt-2 inline-block text-[28px] font-medium text-paper no-underline hover:text-gold" data-reveal style="--i:3">{info.phone}</a>
  </div>

  <form
    method="POST"
    action={info.formAction || undefined}
    class="grid min-w-0 flex-[2_1_520px] grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-5"
    data-reveal
    style="--i:1"
  >
    <input type="hidden" name="usluga" value={service} />
    <label class={field}>Datum
      <input type="date" name="datum" required class={input} />
    </label>
    <label class={field}>Trajanje
      <select name="trajanje" class={input}>
        <option>4 sata</option><option>6 sati</option><option>Ceo dan</option>
      </select>
    </label>
    <label class={field}>Broj gostiju
      <input type="number" name="gosti" min="1" placeholder="npr. 30" required class={input} />
    </label>
    <label class={field}>Vrsta događaja
      <select name="vrsta" class={input}>
        <option>Rođendan</option><option>Godišnjica</option><option>Veridba</option><option>Svadba</option>
        <option>Krštenje / slava</option><option>Poslovni događaj</option><option>Drugo</option>
      </select>
    </label>
    {packages.length > 0 && (
      <label class={field}>Paket
        <select name="paket" class={input}>
          {packages.map((p) => <option>{p}</option>)}
        </select>
      </label>
    )}
    <label class={field}>Ime i prezime
      <input type="text" name="ime" autocomplete="name" required class={input} />
    </label>
    <label class={field}>Email
      <input type="email" name="email" autocomplete="email" required class={input} />
    </label>
    <label class={field}>Telefon
      <input type="tel" name="telefon" autocomplete="tel" class={input} />
    </label>
    <label class:list={[field, 'col-span-full']}>Poruka (alergije, posebne želje)
      <textarea name="poruka" rows="4" class:list={[input, 'resize-y']}></textarea>
    </label>
    <div class="col-span-full">
      <button type="submit" class="btn btn-primary cursor-pointer border-0">Pošalji upit</button>
    </div>
  </form>
</section>
