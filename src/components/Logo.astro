---
import LogoMark from './LogoMark.astro';

interface Props {
  /**
   * "responsive": decagon mark on phones, mark + wordmark from sm up.
   * "full": mark + wordmark at every width. "wordmark": wordmark only.
   */
  mode?: 'responsive' | 'full' | 'wordmark';
  class?: string;
}
const { mode = 'responsive', class: className } = Astro.props;
---

<a href="/" class:list={['flex items-center gap-3.5 text-paper no-underline hover:text-paper', className]} aria-label="Bistromat — početna">
  {mode !== 'wordmark' && <LogoMark variant="icon" class="logo-icon block h-11 w-11 shrink-0" />}
  <LogoMark
    variant="wordmark"
    class:list={['logo-wordmark h-8 w-auto', mode === 'responsive' ? 'hidden sm:block' : 'block']}
  />
</a>

<style>
  .logo-wordmark, .logo-icon { transition: height .25s ease, width .25s ease; }
  :global(#site-header.is-scrolled) .logo-wordmark { height: 1.625rem; }
  :global(#site-header.is-scrolled) .logo-icon { height: 2.25rem; width: 2.25rem; }
  @media (prefers-reduced-motion: reduce) { .logo-wordmark, .logo-icon { transition: none; } }
</style>
