---
// Slow ticker of signature dishes, in the mono face. Static when motion is reduced.
import BrandIcon from './BrandIcon.astro';

const items = [
  'Steak Tartare',
  'Escargot Bourguignon',
  'Soupe à l’oignon',
  'Coq au Vin',
  'Bœuf Bourguignon',
  'Sole Meunière',
  'Crêpe Suzette',
  'Tarte au citron',
  'Crème brûlée',
];
---

<div class="marquee overflow-hidden border-y border-line bg-ink-deep py-5" aria-hidden="true">
  <div class="marquee-track flex w-max">
    {[0, 1].map(() => (
      <ul class="m-0 flex shrink-0 list-none items-center p-0">
        {items.map((t) => (
          <li class="flex items-center whitespace-nowrap text-[16px] uppercase tracking-[0.12em] text-muted">
            <span class="px-7">{t}</span>
            <BrandIcon name="plate" size={12} class="text-gold" />
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee-track { animation: marquee 60s linear infinite; will-change: transform; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>
