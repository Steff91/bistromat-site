---
import EventCard from '../EventCard.astro';
import Icon from '../Icon.astro';
import { getEventItems } from '../../lib/events';

const { upcoming } = await getEventItems();
const next = upcoming.slice(0, 3);
---

<section id="dogadjaji" class="container-site py-24">
  <div class="mb-11 flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="eyebrow" data-reveal>Događaji</p>
      <h2 class="h-section m-0" data-reveal style="--i:1">Narednih večeri u Bistromatu</h2>
    </div>
    <a href="/dogadjaji/" class="inline-flex items-center gap-2 text-[13px]" data-reveal style="--i:2">
      Svi događaji <Icon name="chevron-right" size={10} />
    </a>
  </div>
  {next.length > 0 ? (
    <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-7">
      {next.map((item, i) => <EventCard item={item} index={i} />)}
    </div>
  ) : (
    <p class="m-0 font-sans text-muted">Novi događaji uskoro. <a href="/dogadjaji/">Pogledajte prethodne večeri</a>.</p>
  )}
</section>
