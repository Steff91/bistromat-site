---
import Placeholder from '../Placeholder.astro';
import info from '../../data/info.json';
---

<section class="container-site flex flex-wrap items-center gap-14 pt-[72px] pb-24">
  <div class="min-w-0 flex-[1_1_460px]">
    <p class="eyebrow mb-5" data-reveal>Open Kitchen Concept · {info.landmark}</p>
    <h1 class="m-0 font-medium leading-[1.1] tracking-[-0.02em] [font-size:clamp(34px,4.6vw,60px)]" data-reveal style="--i:1">
      Francuska kuhinja,<br /><em class="font-normal">pred vašim očima.</em>
    </h1>
    <p class="mt-7 max-w-[480px] font-sans text-base text-muted" data-reveal style="--i:2">
      Klasici francuske kuhinje spremljeni u otvorenoj kuhinji, uz pažljivo biranu vinsku kartu. [Kratak opis restorana]
    </p>
    <div class="mt-10 flex flex-wrap gap-3.5" data-reveal style="--i:3">
      <a href="/rezervacije/" class="btn btn-primary">Rezerviši sto</a>
      <a href="#usluge" class="btn btn-outline">Proslave i događaji</a>
    </div>
  </div>
  <div class="min-w-0 flex-[1_1_420px]" data-reveal style="--i:2">
    <Placeholder label="Foto: otvorena kuhinja" class="h-[540px]" />
  </div>
</section>
