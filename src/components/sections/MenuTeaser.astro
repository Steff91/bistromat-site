---
import Placeholder from '../Placeholder.astro';
import Icon from '../Icon.astro';
import info from '../../data/info.json';

// Highlighted dishes stay in HTML (indexable), the full menu is the PDF.
const highlights = [
  { name: 'Escargots de Bourgogne', price: '[CENA]' },
  { name: '[Jelo 2]', price: '[CENA]' },
  { name: '[Jelo 3]', price: '[CENA]' },
];
---

<section id="meni" class="container-site flex flex-wrap items-center gap-14 py-24">
  <div class="min-w-0 flex-[1_1_420px]" data-reveal>
    <Placeholder label="Foto: escargots" class="h-[420px]" />
  </div>
  <div class="min-w-0 flex-[1_1_420px]">
    <p class="eyebrow" data-reveal>Meni</p>
    <h2 class="h-section m-0" data-reveal style="--i:1">Sezonski meni, klasično francuski</h2>
    <ul class="mt-8 flex list-none flex-col gap-4 p-0">
      {highlights.map((d, i) => (
        <li class="flex justify-between gap-4 border-b border-dashed border-[#3A3A3A] pb-3" data-reveal style={`--i:${i + 2}`}>
          <span>{d.name}</span>
          <span class="font-sans text-muted">{d.price}</span>
        </li>
      ))}
    </ul>
    <div class="mt-8 flex flex-wrap gap-3.5" data-reveal style="--i:5">
      <!-- TODO: open PDF flipbook (PDF.js + StPageFlip) in a modal -->
      <a href={info.menuPdf} class="btn btn-primary" data-menu-flipbook>
        <Icon name="book-open" size={14} /> Prelistaj meni
      </a>
      <a href={info.menuPdf} class="btn btn-outline" download>
        <Icon name="download" size={14} /> Preuzmi PDF
      </a>
    </div>
  </div>
</section>
