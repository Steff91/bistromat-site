---
import BookButton from '../BookButton.astro';
import BrandIcon from '../BrandIcon.astro';
import ConsentEmbed from '../ConsentEmbed.astro';
import Placeholder from '../Placeholder.astro';
import { getInfo, getLang, route, tr } from '../../i18n';

const lang = getLang(Astro.url);
const info = getInfo(lang);
---

<section id={tr(lang, 'rezervacija', 'booking')} class="border-t border-line">
  <div class="container-site flex flex-wrap gap-14 py-24">
    <div class="min-w-0 flex-[1_1_380px]">
      <p class="eyebrow inline-flex items-center gap-2.5" data-reveal><BrandIcon name="knife" size={14} />{tr(lang, 'Rezervacije', 'Reservations')}</p>
      <h2 class="h-section m-0" data-reveal style="--i:1">{tr(lang, 'Rezervišite sto', 'Book a table')}</h2>
      <p class="mt-5 font-sans text-muted" data-reveal style="--i:2">{tr(lang, 'Pozovite nas ili rezervišite online.', 'Call us or book online.')}</p>
      <a href={`tel:${info.phoneHref}`} class="mt-4 inline-block text-[32px] font-medium text-paper no-underline hover:text-gold" data-reveal style="--i:3">{info.phone}</a>
      <div class="mt-6" data-reveal style="--i:4">
        <BookButton class="btn btn-primary">{tr(lang, 'Rezerviši online', 'Book online')}</BookButton>
      </div>
    </div>
    <div class="min-w-0 flex-[1_1_460px]" data-reveal style="--i:2">
      {info.reservationEmbed ? (
        <ConsentEmbed html={info.reservationEmbed} label={tr(lang, 'rezervacije', 'booking')} provider={tr(lang, 'sistem za rezervacije', 'the booking system')} />
      ) : (
        <Placeholder label="Foto" src="/images/terasa-sto.webp" alt={tr(lang, 'Postavljen sto u bašti Bistromata', 'A set table in the Bistromat garden')} class="h-[380px]" />
      )}
    </div>
  </div>
</section>
