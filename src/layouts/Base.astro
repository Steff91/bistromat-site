---
import '../styles/global.css';
import Header from '../components/Header.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import BackToTop from '../components/BackToTop.astro';
import { getInfo, getLang, staticAlternates, route, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** This page in each language (for the language switcher and hreflang). Static routes are found automatically. */
  alternates?: Record<Lang, string>;
  /** Share image (1200×630), path from the site root. Defaults to the branded image for the language. */
  ogImage?: string;
}

const lang = getLang(Astro.url);
const info = getInfo(lang);

const {
  title,
  description = `Bistromat, ${info.address}, ${info.city}: ${info.aboutShort}`,
  alternates = staticAlternates(Astro.url.pathname) ?? { sr: route('home', 'sr'), en: route('home', 'en') },
  ogImage = lang === 'en' ? '/og-image-en.jpg' : '/og-image.jpg',
} = Astro.props;
const ogImageUrl = new URL(ogImage, Astro.site);

const canonical = new URL(Astro.url.pathname, Astro.site);

const abs = (path: string) => new URL(path, Astro.site).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': abs('/#restaurant'),
  name: info.name,
  description: info.about,
  servesCuisine: ['French', 'European'],
  priceRange: info.priceRange,
  image: [abs('/og-image.jpg'), abs('/images/sala-otvorena-kuhinja.webp'), abs('/images/escargots.webp')],
  logo: abs('/icon-512.png'),
  telephone: info.phoneHref,
  email: info.email,
  url: abs(route('home', lang)),
  hasMenu: abs(route('menu', lang)),
  address: {
    '@type': 'PostalAddress',
    streetAddress: info.address,
    addressLocality: info.city,
    postalCode: info.postalCode,
    addressCountry: 'RS',
  },
  geo: { '@type': 'GeoCoordinates', latitude: info.geo.lat, longitude: info.geo.lng },
  hasMap: info.mapsLink,
  openingHoursSpecification: info.openingHours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  sameAs: [info.instagram, info.facebook].filter((u) => u.startsWith('http')),
  acceptsReservations: abs(route('reservations', lang)),
  potentialAction: {
    '@type': 'ReserveAction',
    target: { '@type': 'EntryPoint', urlTemplate: abs(route('reservations', lang)), inLanguage: lang, actionPlatform: ['https://schema.org/DesktopWebPlatform', 'https://schema.org/MobileWebPlatform'] },
    result: { '@type': 'FoodEstablishmentReservation', name: lang === 'en' ? 'Table booking' : 'Rezervacija stola' },
  },
};
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'sr-Latn'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sr" href={new URL(alternates.sr, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.sr, Astro.site)} />
    <!-- ?v= busts the browser's favicon cache when the icon changes -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=3" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Bistromat" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'en' ? 'Bistromat dining room looking onto the open kitchen' : 'Sala Bistromata sa pogledom na otvorenu kuhinju'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'sr_RS' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'sr_RS'} />
    <meta name="theme-color" content="#0F0F0F" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <slot name="head" />
  </head>
  <body>
    <TopBar alternates={alternates} />
    <Header alternates={alternates} />
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <CookieBanner />

    <script>
      // Subtle reveal: elements with [data-reveal] fade up once, staggered by --i.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }

      // Forms: thank-you redirect points at the current host (works on preview and production).
      // Until a form handler is set (info.json → formAction), submitting just goes to the thank-you page.
      document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
        const redirect = form.querySelector<HTMLInputElement>('input[name="redirect"]');
        if (!redirect) return;
        const target = new URL(redirect.value);
        redirect.value = location.origin + target.pathname + target.search;
        if (!form.getAttribute('action')) {
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            location.href = redirect.value;
          });
        }
      });
    </script>
  </body>
</html>
