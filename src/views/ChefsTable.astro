---
import FaqList from '../components/FaqList.astro';
import BrandIcon from '../components/BrandIcon.astro';
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Icon from '../components/Icon.astro';
import { upcomingDates, formatDate, dateLabel, seatsLeftLabel } from '../lib/chef-table';
import { getChefTable, getLang, route, timeLabel, tr } from '../i18n';
import { serviceHref } from '../i18n/content';

const lang = getLang(Astro.url);
const en = lang === 'en';
const ct = getChefTable(lang);
const datesId = tr(lang, 'termini', 'dates');
const privateHref = await serviceHref('chefs-table', lang);
const dates = upcomingDates(lang);
const bookable = dates.filter((d) => d.seatsLeft > 0);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ct.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title={tr(lang, "Chef's Table — Bistromat · degustacione večeri uz šefa", "Chef's Table — Bistromat · tasting evenings with the chef")}
  description={tr(lang, "Chef's Table u Bistromatu: degustacioni meni u više sledova uz otvorenu kuhinju, vinsko uparivanje i gostujući šefovi. Naredni termini i rezervacija mesta.", "Chef's Table at Bistromat: a multi-course tasting menu by the open kitchen, wine pairing and guest chefs. Upcoming dates and seat booking.")}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="container-site pt-16 pb-20">
    <p class="mb-7 text-[14px] text-dim">
      <a href={route('home', lang)} class="text-dim hover:text-paper">{tr(lang, 'Početna', 'Home')}</a> / Chef's Table
    </p>
    <div class="flex flex-wrap items-center gap-14">
      <div class="min-w-0 flex-[1_1_460px]">
        <p class="eyebrow inline-flex items-center gap-2.5 mb-[18px]" data-reveal><BrandIcon name="plate" size={14} />Chef's Table</p>
        <h1 class="m-0 font-medium leading-[1.1] tracking-[-0.02em] [font-size:clamp(32px,4.4vw,56px)]" data-reveal style="--i:1">
          {en ? <>Dinner at<br /><em class="font-normal">the chef's table.</em></> : <>Večera za<br /><em class="font-normal">šefovim stolom.</em></>}
        </h1>
        <p class="mt-6 max-w-[500px] font-sans text-base text-muted" data-reveal style="--i:2">{ct.intro}</p>
        <div class="mt-9 flex flex-wrap gap-3.5" data-reveal style="--i:3">
          <a href="#upit" class="btn btn-primary">{tr(lang, 'Rezerviši mesto', 'Book a seat')}</a>
          <a href={`#${datesId}`} class="btn btn-outline">{tr(lang, 'Naredni termini', 'Upcoming dates')}</a>
        </div>
      </div>
      <div class="min-w-0 flex-[1_1_420px]" data-reveal style="--i:2">
        <Placeholder label={tr(lang, 'Foto: šef za stolom', 'Photo: chef at the table')} class="h-[480px]" />
      </div>
    </div>

    <dl class="mt-14 mb-0 grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-px border border-line bg-line">
      {ct.facts.map((f, i) => (
        <div class="bg-ink px-6 py-5" data-reveal style={`--i:${i}`}>
          <dt class="text-[13px] uppercase tracking-[0.12em] text-dim">{f.label}</dt>
          <dd class="m-0 mt-1.5 text-[17px] font-medium">{f.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Upcoming dates -->
  <section id={datesId} aria-labelledby="termini-h" class="border-t border-line">
    <div class="container-site py-24">
      <p class="eyebrow" data-reveal>{tr(lang, 'Naredni termini', 'Upcoming dates')}</p>
      <h2 id="termini-h" class="h-section m-0 mb-11" data-reveal style="--i:1">{tr(lang, 'Izaberite veče', 'Choose your evening')}</h2>

      {dates.length > 0 ? (
        <ul class="m-0 list-none border-t border-line p-0" data-ct-dates>
          {dates.map((d, i) => {
            const full = d.seatsLeft <= 0;
            return (
              <li class="flex flex-wrap items-center gap-x-10 gap-y-3 border-b border-line py-6" data-date={d.date} data-reveal style={`--i:${i % 4}`}>
                <div class="min-w-[220px] flex-[0_0_auto]">
                  <p class="m-0 text-lg font-semibold">{formatDate(d.date, lang)}</p>
                  <p class="m-0 mt-1 text-[14px] text-dim">{timeLabel(d.time, lang)}</p>
                </div>
                <div class="min-w-0 flex-[1_1_260px]">
                  <p class="m-0 font-medium">{d.theme} {d.guest && <span class="text-gold">{d.guest}</span>}</p>
                  <p class="m-0 mt-1 font-sans text-[16px] text-muted">{d.price}</p>
                </div>
                <div class="flex flex-[0_0_auto] items-center gap-6">
                  <span class:list={['text-[14px] uppercase tracking-[0.08em]', full ? 'text-dim' : 'text-gold']}>
                    {seatsLeftLabel(d.seatsLeft, lang)}
                  </span>
                  {full ? (
                    <span class="btn btn-outline pointer-events-none opacity-40" aria-hidden="true">{tr(lang, 'Rezerviši', 'Book')}</span>
                  ) : (
                    <a href="#upit" class="btn btn-outline" data-book={d.date}>{tr(lang, 'Rezerviši', 'Book')}</a>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      ) : null}
      <p class:list={['mt-6 mb-0 font-sans text-muted', dates.length > 0 && 'hidden']} data-ct-empty>
        {en
          ? <>New dates coming soon. Follow us on <a href="https://www.instagram.com/bistromat_/">Instagram</a> or call to join the waiting list.</>
          : <>Novi termini uskoro. Pratite nas na <a href="https://www.instagram.com/bistromat_/">Instagramu</a> ili pozovite za listu čekanja.</>}
      </p>
    </div>
  </section>

  <!-- How the evening goes -->
  <section aria-labelledby="vece" class="bg-paper text-ink">
    <div class="container-site py-24">
      <p class="eyebrow !text-gold-dark" data-reveal>{tr(lang, 'Kako izgleda veče', 'How the evening goes')}</p>
      <h2 id="vece" class="h-section m-0 mb-12" data-reveal style="--i:1">{tr(lang, 'Od dobrodošlice do deserta', 'From welcome to dessert')}</h2>
      <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-x-10 gap-y-10 p-0">
        {ct.timeline.map((t, i) => (
          <li class="border-t border-[#BDB7AD] pt-5" data-reveal style={`--i:${i}`}>
            <p class="m-0 text-[28px] font-medium">{t.time}</p>
            <h3 class="mt-2 mb-2 text-[17px] font-semibold uppercase tracking-[0.03em]">{t.title}</h3>
            <p class="m-0 font-sans text-body-dark">{t.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Chef -->
  <section aria-labelledby="sef" class="container-site py-24">
    <div class="flex flex-wrap items-center gap-14">
      <div class="min-w-0 flex-[1_1_380px]" data-reveal>
        <Placeholder label={tr(lang, 'Foto: šef', 'Photo: chef')} src={ct.chef.image || undefined} alt={ct.chef.name} class="h-[520px]" />
      </div>
      <div class="min-w-0 flex-[1_1_460px]">
        <p class="eyebrow" data-reveal>{ct.chef.role}</p>
        <h2 id="sef" class="h-section m-0" data-reveal style="--i:1">{ct.chef.name}</h2>
        <p class="mt-6 font-sans text-base text-muted" data-reveal style="--i:2">{ct.chef.bio}</p>
        <blockquote class="mt-8 mb-0 border-l-0 p-0 text-xl leading-snug" data-reveal style="--i:3">
          <span class="text-gold">“</span><em class="font-normal">{ct.chef.quote}</em><span class="text-gold">”</span>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Sample menu -->
  <section aria-labelledby="primer" class="border-y border-line bg-ink-deep">
    <div class="container-site py-24">
      <div class="mx-auto max-w-[760px]">
        <p class="eyebrow text-center" data-reveal>{tr(lang, 'Primer menija', 'Sample menu')}</p>
        <h2 id="primer" class="h-section m-0 text-center" data-reveal style="--i:1">{ct.sampleMenu.title}</h2>
        <ol class="mt-12 mb-0 list-none p-0">
          {ct.sampleMenu.courses.map((c, i) => (
            <li class="grid grid-cols-1 gap-1 border-b border-dashed border-[#3A3A3A] py-5 sm:grid-cols-[140px_1fr]" data-reveal style={`--i:${i % 4}`}>
              <span class="text-[14px] uppercase tracking-[0.1em] text-gold">{c.course}</span>
              <span>
                <span class="block font-medium">{c.dish}</span>
                <span class="mt-1 block font-sans text-[15px] text-dim">{tr(lang, 'Uz', 'With')}: {c.wine}</span>
              </span>
            </li>
          ))}
        </ol>
        <p class="mt-6 mb-0 text-center font-sans text-[15px] text-dim">{tr(lang, 'Meni se menja za svako veče. Ovo je primer jedne od prethodnih večeri.', 'The menu changes every evening. This is an example from a past one.')}</p>
      </div>
    </div>
  </section>

  <!-- Past evenings -->
  <section aria-labelledby="prethodne" class="container-site py-24">
    <p class="eyebrow" data-reveal>{tr(lang, 'Prethodne večeri', 'Past evenings')}</p>
    <h2 id="prethodne" class="h-section m-0 mb-11" data-reveal style="--i:1">{tr(lang, 'Gostujući šefovi i vinarije', 'Guest chefs and wineries')}</h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-6">
      {ct.past.map((p, i) => (
        <figure class="m-0" data-reveal style={`--i:${i}`}>
          <Placeholder label={tr(lang, 'Foto večeri', 'Photo of the evening')} src={p.image || undefined} alt={p.title} class="aspect-[4/5]" />
          <figcaption class="mt-3">
            <span class="block text-[16px] font-semibold uppercase tracking-[0.03em]">{p.title}</span>
            <span class="mt-1 block text-[14px] text-dim">{p.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section aria-labelledby="pitanja" class="border-t border-line">
    <div class="container-site flex flex-wrap gap-14 py-24">
      <div class="min-w-0 flex-[1_1_280px]">
        <p class="eyebrow" data-reveal>{tr(lang, 'Česta pitanja', 'FAQ')}</p>
        <h2 id="pitanja" class="h-section m-0" data-reveal style="--i:1">{tr(lang, 'Pre nego što pitate', 'Before you ask')}</h2>
      </div>
      <div class="min-w-0 flex-[2_1_520px]">
          <FaqList items={ct.faq} />
        </div>
    </div>
  </section>

  <!-- Booking -->
  {bookable.length > 0 && (
    <div class="border-t border-line">
      <InquiryForm
        service="Chef's Table"
        variant="seats"
        dates={bookable.map((d) => ({ value: d.date, label: dateLabel(d, lang) }))}
      />
    </div>
  )}

  <!-- Private Chef's Table -->
  <section class="bg-paper text-ink">
    <div class="container-site flex flex-wrap items-center justify-between gap-8 py-16">
      <div class="max-w-[620px]" data-reveal>
        <p class="eyebrow !text-gold-dark">{tr(lang, 'Za vašu grupu', 'For your group')}</p>
        <h2 class="h-section m-0">{tr(lang, "Ceo šefov sto samo za vas", "The whole chef's table, just for you")}</h2>
        <p class="mt-3 mb-0 font-sans text-body-dark">{tr(lang, 'Za rođendane, godišnjice i poslovne večere šef priprema degustaciju samo za vašu grupu, u terminu koji vam odgovara.', 'For birthdays, anniversaries and business dinners, the chef prepares a tasting for your group only, on a date that suits you.')}</p>
      </div>
      <a href={privateHref} class="btn btn-dark" data-reveal style="--i:1">
        {tr(lang, "Privatni Chef's Table", "Private Chef's Table")} <Icon name="chevron-right" size={11} />
      </a>
    </div>
  </section>
</Base>


<script>
  // Hide dates that passed since the last build, and the matching form options.
  const today = new Date().toISOString().slice(0, 10);
  const list = document.querySelector<HTMLElement>('[data-ct-dates]');
  const select = document.getElementById('seats-date') as HTMLSelectElement | null;
  list?.querySelectorAll<HTMLElement>('[data-date]').forEach((li) => {
    if ((li.dataset.date ?? '') < today) li.remove();
  });
  select?.querySelectorAll('option').forEach((o) => { if (o.value < today) o.remove(); });
  if (list && !list.querySelector('[data-date]')) {
    list.remove();
    document.querySelector('[data-ct-empty]')?.classList.remove('hidden');
  }

  // "Rezerviši" on a date preselects it in the form.
  document.querySelectorAll<HTMLAnchorElement>('[data-book]').forEach((a) =>
    a.addEventListener('click', () => {
      if (select) select.value = a.dataset.book ?? '';
    }),
  );
</script>
