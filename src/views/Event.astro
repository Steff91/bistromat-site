---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import InquiryForm from '../components/InquiryForm.astro';
import EventCard from '../components/EventCard.astro';
import Icon from '../components/Icon.astro';
import { eventTypes, formatDate, getEventItems, isPast, seatsLabel } from '../lib/events';
import { getInfo, getLang, route, timeLabel, tr } from '../i18n';
import type { Localized } from '../i18n/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  event: Localized<CollectionEntry<'events'>['data']>;
}

const { event } = Astro.props;
const lang = getLang(Astro.url);
const en = lang === 'en';
const info = getInfo(lang);
const EVENT_TYPES = eventTypes(lang);
const d = event.data;
const { Content } = await render(event.bodyEntry);
const hasBody = Boolean(event.bodyEntry.body?.trim());
const past = isPast(d.date);
const full = d.seatsLeft !== undefined && d.seatsLeft <= 0;
const seats = seatsLabel(d.seatsLeft, lang);
const others = (await getEventItems(lang)).upcoming.filter((i) => i.key !== event.ref).slice(0, 3);
const icsHref = `${event.href.replace(/\/$/, "")}.ics`;

const SEATS = tr(lang, 'Mesta', 'Seats');
const facts = [
  { label: tr(lang, 'Datum', 'Date'), value: formatDate(d.date, lang) },
  { label: tr(lang, 'Vreme', 'Time'), value: timeLabel(d.endTime ? `${d.time}–${d.endTime}` : d.time, lang) },
  d.price && { label: tr(lang, 'Cena', 'Price'), value: d.price },
  !past && seats && { label: SEATS, value: seats },
].filter(Boolean) as { label: string; value: string }[];

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: d.title,
  description: d.excerpt,
  startDate: `${d.date}T${d.time}`,
  ...(d.endTime && { endDate: `${d.date}T${d.endTime}` }),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: info.name,
    address: { '@type': 'PostalAddress', streetAddress: info.address, addressLocality: info.city, addressCountry: 'RS' },
  },
  organizer: { '@type': 'Organization', name: info.name, url: site },
  ...(d.image && { image: [`${site}${d.image}`] }),
  ...(d.guest && { performer: { '@type': 'Person', name: d.guest.name } }),
};
---

<Base title={`${d.title} · ${formatDate(d.date, lang)} — Bistromat`} description={d.excerpt} alternates={event.alternates}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section class="container-site pt-16 pb-20">
    <p class="mb-7 text-[14px] text-dim">
      <a href={route('home', lang)} class="text-dim hover:text-paper">{tr(lang, 'Početna', 'Home')}</a> / <a href={route('events', lang)} class="text-dim hover:text-paper">{tr(lang, 'Događaji', 'Events')}</a> / {d.title}
    </p>
    <div class="flex flex-wrap items-center gap-14">
      <div class="min-w-0 flex-[1_1_460px]">
        <p class="eyebrow mb-[18px]" data-reveal>
          {EVENT_TYPES[d.type]}{past && <span class="ml-3 rounded-sm border border-dim px-2 py-0.5 text-dim">{tr(lang, 'Završeno', 'Ended')}</span>}
        </p>
        <h1 class="m-0 font-medium leading-[1.1] tracking-[-0.02em] [font-size:clamp(32px,4.4vw,56px)]" data-reveal style="--i:1">{d.title}</h1>
        <p class="mt-6 max-w-[500px] font-sans text-base text-muted" data-reveal style="--i:2">{d.excerpt}</p>
        {!past && (
          <div class="mt-9 flex flex-wrap gap-3.5" data-reveal style="--i:3">
            {d.booking === 'form' && !full && <a href="#upit" class="btn btn-primary">{tr(lang, 'Rezerviši mesto', 'Book a seat')}</a>}
            {(d.booking === 'phone' || full) && <a href={`tel:${info.phoneHref}`} class="btn btn-primary">{full ? tr(lang, 'Lista čekanja', 'Waiting list') : tr(lang, 'Rezerviši', 'Book')}: {info.phone}</a>}
            <a href={icsHref} class="btn btn-outline" download>{tr(lang, 'Dodaj u kalendar', 'Add to calendar')}</a>
          </div>
        )}
      </div>
      <div class="min-w-0 flex-[1_1_420px]" data-reveal style="--i:2">
        <Placeholder label={tr(lang, 'Foto događaja', 'Event photo')} src={d.image} alt={d.title} eager class="h-[460px]" />
      </div>
    </div>

    <dl class="mt-14 mb-0 grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-px border border-line bg-line">
      {facts.map((f, i) => (
        <div class="bg-ink px-6 py-5" data-reveal style={`--i:${i}`}>
          <dt class="text-[13px] uppercase tracking-[0.12em] text-dim">{f.label}</dt>
          <dd class:list={['m-0 mt-1.5 text-[17px] font-medium', f.label === SEATS && (full ? 'text-dim' : 'text-gold')]}>{f.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Description + program -->
  {(hasBody || d.program.length > 0) && (
    <section class="border-t border-line">
      <div class="container-site flex flex-wrap gap-14 py-20">
        {hasBody && (
          <div class="min-w-0 flex-[2_1_480px]" data-reveal>
            <p class="eyebrow">{tr(lang, 'O večeri', 'About the evening')}</p>
            <div class="font-sans text-base text-muted [&_p]:mt-0 [&_p]:mb-4">
              <Content />
            </div>
          </div>
        )}
        {d.program.length > 0 && (
          <div class="min-w-0 flex-[1_1_300px]" data-reveal style="--i:1">
            <p class="eyebrow">Program</p>
            <ol class="m-0 list-none border-t border-line p-0">
              {d.program.map((p) => (
                <li class="flex gap-6 border-b border-line py-4">
                  <span class="w-14 shrink-0 text-gold">{p.time}</span>
                  <span>{p.title}</span>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Menu -->
  {d.menu.length > 0 && (
    <section aria-labelledby="meni-veceri" class="border-y border-line bg-ink-deep">
      <div class="container-site py-20">
        <div class="mx-auto max-w-[760px]">
          <p class="eyebrow text-center" data-reveal>{tr(lang, 'Meni večeri', "The evening's menu")}</p>
          <h2 id="meni-veceri" class="h-section m-0 text-center" data-reveal style="--i:1">{d.menu.length} {tr(lang, 'sledova', 'courses')}</h2>
          <ol class="mt-10 mb-0 list-none p-0">
            {d.menu.map((c, i) => (
              <li class="grid grid-cols-1 gap-1 border-b border-dashed border-[#3A3A3A] py-5 sm:grid-cols-[140px_1fr]" data-reveal style={`--i:${i % 4}`}>
                <span class="text-[14px] uppercase tracking-[0.1em] text-gold">{c.course}</span>
                <span>
                  <span class="block font-medium">{c.dish}</span>
                  {c.wine && <span class="mt-1 block font-sans text-[15px] text-dim">{tr(lang, 'Uz', 'With')}: {c.wine}</span>}
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )}

  <!-- Guest -->
  {d.guest && (
    <section aria-labelledby="gost" class="bg-paper text-ink">
      <div class="container-site flex flex-wrap items-center gap-14 py-24">
        <div class="min-w-0 flex-[1_1_320px] max-w-[440px]" data-reveal>
          <Placeholder label={`${tr(lang, 'Foto', 'Photo')}: ${d.guest.role.toLowerCase()}`} src={d.guest.image} alt={d.guest.name} class="aspect-[4/5]" light />
        </div>
        <div class="min-w-0 flex-[1_1_420px]">
          <p class="eyebrow !text-gold-dark" data-reveal>{d.guest.role}</p>
          <h2 id="gost" class="h-section m-0" data-reveal style="--i:1">{d.guest.name}</h2>
          <p class="mt-6 font-sans text-base text-body-dark" data-reveal style="--i:2">{d.guest.bio}</p>
          {d.guest.link && (
            <a href={d.guest.link} class="mt-4 inline-flex items-center gap-2 text-[14px] text-gold-dark hover:text-ink" target="_blank" rel="noopener" data-reveal style="--i:3">
              {tr(lang, 'Više o gostu', 'More about our guest')} <Icon name="chevron-right" size={10} />
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Gallery (past events) -->
  {past && d.gallery.length > 0 && (
    <section aria-label={tr(lang, 'Fotografije sa večeri', 'Photos from the evening')} class="container-site py-20">
      <p class="eyebrow" data-reveal>{tr(lang, 'Fotografije sa večeri', 'Photos from the evening')}</p>
      <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
        {d.gallery.map((g, i) => (
          <div data-reveal style={`--i:${i % 4}`}>
            <Placeholder label={g.alt} src={g.src} alt={g.alt} class="aspect-square" />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Booking -->
  {!past && d.booking === 'form' && !full && (
    <div class="border-t border-line">
      <InquiryForm service={d.title} variant="seats" dates={[{ value: d.date, label: `${formatDate(d.date, lang)} · ${timeLabel(d.time, lang)}` }]} />
    </div>
  )}
  {!past && (d.booking === 'phone' || full) && (
    <section class="border-t border-line">
      <div class="container-site flex flex-wrap items-center justify-between gap-6 py-16">
        <div>
          <h2 class="h-section m-0">{full ? tr(lang, 'Sva mesta su popunjena', 'Fully booked') : tr(lang, 'Rezervacija telefonom', 'Book by phone')}</h2>
          <p class="mt-3 mb-0 font-sans text-muted">{full ? tr(lang, 'Pozovite nas da vas upišemo na listu čekanja.', 'Call us to join the waiting list.') : tr(lang, 'Sto za ovu večer rezervišite telefonom.', 'Book a table for this evening by phone.')}</p>
        </div>
        <a href={`tel:${info.phoneHref}`} class="text-[28px] font-medium text-paper no-underline hover:text-gold">{info.phone}</a>
      </div>
    </section>
  )}

  <!-- Other events -->
  {others.length > 0 && (
    <section aria-labelledby="ostali" class="border-t border-line">
      <div class="container-site py-20">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="eyebrow" data-reveal>{tr(lang, 'Predstojeći događaji', 'Upcoming events')}</p>
            <h2 id="ostali" class="h-section m-0" data-reveal style="--i:1">{tr(lang, 'Još večeri u Bistromatu', 'More evenings at Bistromat')}</h2>
          </div>
          <a href={route('events', lang)} class="inline-flex items-center gap-2 text-[14px]" data-reveal style="--i:2">
            {tr(lang, 'Svi događaji', 'All events')} <Icon name="chevron-right" size={10} />
          </a>
        </div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-7">
          {others.map((item, i) => <EventCard item={item} index={i} />)}
        </div>
      </div>
    </section>
  )}
</Base>
