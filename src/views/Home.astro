---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Concept from '../components/sections/Concept.astro';
import MenuTeaser from '../components/sections/MenuTeaser.astro';
import Services from '../components/sections/Services.astro';
import ChefTable from '../components/sections/ChefTable.astro';
import Events from '../components/sections/Events.astro';
import Reviews from '../components/sections/Reviews.astro';
import Reservation from '../components/sections/Reservation.astro';
import Contact from '../components/sections/Contact.astro';
import Instagram from '../components/sections/Instagram.astro';
import Marquee from '../components/Marquee.astro';
import IconRule from '../components/IconRule.astro';
import { getLang, tr } from '../i18n';
import { FEATURES } from '../config';

const lang = getLang(Astro.url);
---

<Base
  title={tr(lang, 'Bistromat — francuski restoran na Vračaru, Beograd', 'Bistromat — French restaurant in Vračar, Belgrade')}
  description={tr(lang, 'Francuski restoran sa otvorenom kuhinjom na Vračaru, kod Hrama Svetog Save. Klasici po Escoffier-u i lokalne namirnice. Rezervišite sto online.', 'French restaurant with an open kitchen in Vračar, by the Temple of Saint Sava, Belgrade. Escoffier classics, local produce. Book a table online.')}
>
  <Hero />
  <Marquee />
  <Concept />
  <MenuTeaser />
  <IconRule class:list={[!FEATURES.services && 'pb-24']} />
  <Services />
  {FEATURES.chefsTable && <ChefTable />}
  {FEATURES.events && <Events />}
  <Reviews />
  <Reservation />
  <Contact />
  <Instagram />
</Base>
