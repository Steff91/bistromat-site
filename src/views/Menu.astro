---
import BookButton from '../components/BookButton.astro';
import BrandIcon from '../components/BrandIcon.astro';
import Base from '../layouts/Base.astro';
import MenuFlipbook from '../components/MenuFlipbook.astro';
import MenuList from '../components/MenuList.astro';
import menuItems from '../data/menu-items.json';
import Icon from '../components/Icon.astro';
import { getInfo, getLang, getMenu, route, tr } from '../i18n';
import { serviceHref } from '../i18n/content';
import { FEATURES } from '../config';

const lang = getLang(Astro.url);
const info = getInfo(lang);
const menu = getMenu(lang);
const mainPdf = menu.cards[0]?.pdf;
const partiesHref = await serviceHref('privatne-proslave', lang);
const en = lang === 'en';

// schema.org Menu: every dish with its price, so search engines can read the menu.
const menuSchema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: tr(lang, 'Meni — Bistromat', 'Menu — Bistromat'),
  inLanguage: en ? 'en' : 'sr',
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  hasMenuSection: menuItems.sections.map((s) => ({
    '@type': 'MenuSection',
    name: s[lang],
    hasMenuItem: s.items.map((it) => ({
      '@type': 'MenuItem',
      name: it[lang].name,
      ...('desc' in it[lang] && it[lang].desc ? { description: it[lang].desc } : {}),
      offers: { '@type': 'Offer', price: it.price.replace('.', ''), priceCurrency: menuItems.currency },
    })),
  })),
};
---

<Base
  title={tr(lang, 'Meni — Bistromat, francuski restoran · Vračar, Beograd', 'Menu — Bistromat, French restaurant · Vračar, Belgrade')}
  description={tr(lang, 'Meni francuskog restorana Bistromat: steak tartare, puževi, supa od luka, Coq au Vin, crème brûlée. Cene, vinska karta i kokteli. Vračar, Beograd.', "Menu of Bistromat, a French restaurant in Belgrade: steak tartare, escargots, onion soup, Coq au Vin, crème brûlée. Prices, wine list and cocktails.")}
>
  <!-- Intro -->
  <section class="container-site pt-16 pb-20">
    <p class="mb-7 text-[14px] text-dim">
      <a href={route('home', lang)} class="text-dim hover:text-paper">{tr(lang, 'Početna', 'Home')}</a> / {tr(lang, 'Meni', 'Menu')}
    </p>
    <div class="flex flex-wrap items-end justify-between gap-10">
      <div class="min-w-0 flex-[1_1_560px]">
        <p class="eyebrow inline-flex items-center gap-2.5 mb-[18px]" data-reveal><BrandIcon name="fork" size={14} />{tr(lang, 'Meni', 'Menu')} · {menu.season}</p>
        <h1 class="m-0 font-medium leading-[1.1] tracking-[-0.02em] [font-size:clamp(32px,4.4vw,56px)]" data-reveal style="--i:1">
          {en ? <>A seasonal menu,<br /><em class="font-normal">classically French.</em></> : <>Sezonski meni,<br /><em class="font-normal">klasično francuski.</em></>}
        </h1>
        <p class="mt-6 max-w-[560px] font-sans text-base text-muted" data-reveal style="--i:2">{menu.intro}</p>
      </div>
      <div class="flex flex-col items-start gap-4" data-reveal style="--i:3">
        <div class="flex flex-wrap gap-3.5">
          <BookButton class="btn btn-primary">{tr(lang, 'Rezerviši sto', 'Book a table')}</BookButton>
          {mainPdf && (
            <a href={mainPdf} class="btn btn-outline" download>
              <Icon name="download" size={14} /> {tr(lang, 'Preuzmi PDF', 'Download PDF')}
            </a>
          )}
        </div>
        <p class="m-0 text-[14px] text-dim">{tr(lang, 'Ažurirano', 'Updated')}: {menu.updated}</p>
      </div>
    </div>
  </section>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(menuSchema)} />

  <!-- Flipbook -->
  <section aria-label={tr(lang, 'Pregled menija', 'Menu viewer')} class="border-y border-line bg-ink-deep py-20">
    <div class="container-site">
      <MenuFlipbook />
    </div>
  </section>

  <!-- Full menu as text (indexable) -->
  <section aria-labelledby="ceo-meni" class="container-site py-24">
    <div class="mx-auto max-w-[860px]">
      <p class="eyebrow" data-reveal>{tr(lang, 'Ručak i večera', 'Lunch and dinner')}</p>
      <h2 id="ceo-meni" class="h-section m-0" data-reveal style="--i:1">{tr(lang, 'Ceo meni', 'The full menu')}</h2>
      <p class="mt-4 mb-10 max-w-[560px] font-sans text-muted" data-reveal style="--i:2">
        {tr(lang, 'Sva jela sa trenutne karte. Vinsku kartu i koktele prelistajte iznad.', 'Every dish on the current menu. Browse the wine list and cocktails above.')}
      </p>
      <div data-reveal style="--i:3"><MenuList /></div>
    </div>
  </section>

  <!-- Chef's picks (HTML for SEO) -->
  <section aria-labelledby="preporuka" class="bg-paper text-ink">
    <div class="container-site py-24">
      <p class="eyebrow !text-gold-dark" data-reveal>{tr(lang, 'Preporuka šefa', "Chef's picks")}</p>
      <h2 id="preporuka" class="h-section m-0 mb-11" data-reveal style="--i:1">{tr(lang, 'Jela koja ne treba propustiti', 'Dishes not to miss')}</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-x-12 gap-y-8">
        {menu.highlights.map((d, i) => (
          <div class="border-b border-dashed border-[#BDB7AD] pb-6" data-reveal style={`--i:${i % 4}`}>
            <div class="flex items-baseline gap-3">
              <h3 class="m-0 text-lg font-semibold">{d.name}</h3>
              <span class="leader" aria-hidden="true"></span>
              <span class="shrink-0 font-sans text-body-dark">{d.price}</span>
            </div>
            <p class="mt-2 mb-0 font-sans text-[16px] text-body-dark">{d.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Practical info -->
  <section aria-label={tr(lang, 'Informacije', 'Information')} class="container-site py-20">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-10">
      <div data-reveal>
        <p class="eyebrow mb-2">{tr(lang, 'Alergeni', 'Allergens')}</p>
        <p class="m-0 font-sans text-muted">{menu.allergens}</p>
      </div>
      <div data-reveal style="--i:1">
        <p class="eyebrow mb-2">{tr(lang, 'Sezonski meni', 'Seasonal menu')}</p>
        <p class="m-0 font-sans text-muted">{tr(lang, 'Karta prati sezonu, a šef svake nedelje dodaje jela van menija. Pitajte osoblje za današnju ponudu.', "The menu follows the seasons, and every week the chef adds dishes off the menu. Ask our staff about today's specials.")}</p>
      </div>
      {FEATURES.services && <div data-reveal style="--i:2">
        <p class="eyebrow mb-2">{tr(lang, 'Privatni događaji', 'Private events')}</p>
        <p class="m-0 font-sans text-muted">{tr(lang, 'Za proslave i poslovne večere meni sastavljamo po vašoj meri.', 'For celebrations and business dinners we put together a menu around you.')}</p>
        <a href={partiesHref} class="mt-3 inline-flex items-center gap-2 text-[14px]">
          {tr(lang, 'Proslave i događaji', 'Parties & events')} <Icon name="chevron-right" size={10} />
        </a>
      </div>}
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-line">
    <div class="container-site flex flex-wrap items-center justify-between gap-8 py-16">
      <div data-reveal>
        <h2 class="h-section m-0">{tr(lang, 'Rezervišite sto', 'Book a table')}</h2>
        <p class="mt-3 mb-0 font-sans text-muted">{tr(lang, 'Pozovite nas ili rezervišite online.', 'Call us or book online.')}</p>
      </div>
      <div class="flex flex-wrap items-center gap-6" data-reveal style="--i:1">
        <a href={`tel:${info.phoneHref}`} class="text-[28px] font-medium text-paper no-underline hover:text-gold">{info.phone}</a>
        <BookButton class="btn btn-primary">{tr(lang, 'Rezerviši', 'Book')}</BookButton>
      </div>
    </div>
  </section>
</Base>
