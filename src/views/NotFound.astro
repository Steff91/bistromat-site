---
import Base from '../layouts/Base.astro';
import BrandIcon from '../components/BrandIcon.astro';
import Icon from '../components/Icon.astro';
import { getLang, route, tr } from '../i18n';

const lang = getLang(Astro.url);
const en = lang === 'en';
---

<Base title={tr(lang, 'Stranica nije pronađena — Bistromat', 'Page not found — Bistromat')} description={tr(lang, 'Stranica koju tražite ne postoji.', 'The page you are looking for does not exist.')}>
  <section class="container-site flex min-h-[70vh] flex-col items-center justify-center py-24 text-center">
    <div class="flex items-end gap-6 text-[#3A3A3A]" aria-hidden="true">
      <BrandIcon name="fork" size={90} />
      <BrandIcon name="plate" size={90} class="text-gold" />
      <BrandIcon name="knife" size={90} />
    </div>
    <p class="eyebrow mt-12">404</p>
    <h1 class="m-0 font-medium leading-[1.1] tracking-[-0.02em] [font-size:clamp(30px,4vw,48px)]">
      {en ? <>This dish is not<br /><em class="font-normal">on the menu.</em></> : <>Ovo jelo nije<br /><em class="font-normal">na meniju.</em></>}
    </h1>
    <p class="mt-5 max-w-[440px] font-sans text-muted">{tr(lang, 'Stranica koju tražite ne postoji ili je premeštena. Možda vas zanima nešto od ovoga:', 'The page you are looking for does not exist or has moved. Perhaps one of these:')}</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3.5">
      <a href={route('home', lang)} class="btn btn-primary">{tr(lang, 'Početna', 'Home')}</a>
      <a href={route('menu', lang)} class="btn btn-outline">{tr(lang, 'Meni', 'Menu')}</a>
      <a href={route('reservations', lang)} class="btn btn-outline">{tr(lang, 'Rezervacije', 'Reservations')} <Icon name="chevron-right" size={10} /></a>
    </div>
  </section>
</Base>
