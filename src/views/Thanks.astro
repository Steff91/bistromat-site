---
import Base from '../layouts/Base.astro';
import BrandIcon from '../components/BrandIcon.astro';
import Icon from '../components/Icon.astro';
import { getInfo, getLang, route, tr } from '../i18n';

const lang = getLang(Astro.url);
const info = getInfo(lang);

// Message varies by form type, passed as ?tip=… (set in each form's redirect URL).
const messages = lang === 'en' ? {
  upit: {
    title: ['Your inquiry has arrived.', 'Thank you.'],
    text: 'We will get back to you shortly with a proposal and a quote, usually the same or the next day.',
  },
  rezervacija: {
    title: ['Your booking has been sent.', 'See you soon.'],
    text: 'Your table is not confirmed yet. We will confirm by message or phone, at the latest a few hours before your booking.',
  },
  poruka: {
    title: ['Your message has arrived.', 'Thank you.'],
    text: 'We will reply as soon as we can. For anything urgent, calling is quickest.',
  },
} : {
  upit: {
    title: ['Upit je stigao.', 'Hvala vam.'],
    text: 'Javljamo vam se u najkraćem roku sa predlogom i ponudom, obično tokom istog ili narednog dana.',
  },
  rezervacija: {
    title: ['Rezervacija je poslata.', 'Vidimo se uskoro.'],
    text: 'Sto još nije potvrđen. Potvrdu šaljemo porukom ili pozivom, najkasnije nekoliko sati pre termina.',
  },
  poruka: {
    title: ['Poruka je stigla.', 'Hvala vam.'],
    text: 'Odgovaramo u najkraćem roku. Za hitne stvari najbrže je telefonom.',
  },
};
---

<Base title={tr(lang, 'Hvala — Bistromat', 'Thank you — Bistromat')} description={tr(lang, 'Vaša poruka je uspešno poslata.', 'Your message was sent successfully.')}>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <section class="container-site flex min-h-[70vh] flex-col items-center justify-center py-24 text-center" data-thanks>
    <div class="flex items-end gap-6 text-[#3A3A3A]" aria-hidden="true">
      <BrandIcon name="glass" size={70} />
      <BrandIcon name="plate" size={90} class="text-gold" />
      <BrandIcon name="glass" size={70} />
    </div>
    <p class="eyebrow mt-12">Merci !</p>
    <h1 class="m-0 font-medium leading-[1.1] tracking-[-0.02em] [font-size:clamp(30px,4vw,48px)]">
      <span data-t1>{messages.upit.title[0]}</span><br /><em class="font-normal" data-t2>{messages.upit.title[1]}</em>
    </h1>
    <p class="mt-5 max-w-[460px] font-sans text-muted" data-text>{messages.upit.text}</p>
    <p class="mt-2 font-sans text-muted">
      {tr(lang, 'Telefon', 'Phone')}: <a href={`tel:${info.phoneHref}`} class="text-paper hover:text-gold">{info.phone}</a>
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3.5">
      <a href={route('home', lang)} class="btn btn-primary">{tr(lang, 'Početna', 'Home')}</a>
      <a href={route('menu', lang)} class="btn btn-outline">{tr(lang, 'Pogledaj meni', 'See the menu')} <Icon name="chevron-right" size={10} /></a>
    </div>
  </section>
</Base>

<script define:vars={{ messages }}>
  const tip = new URLSearchParams(location.search).get('tip');
  const m = messages[tip];
  if (m) {
    document.querySelector('[data-t1]').textContent = m.title[0];
    document.querySelector('[data-t2]').textContent = m.title[1];
    document.querySelector('[data-text]').textContent = m.text;
  }
</script>
